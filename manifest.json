{
  "manifest_version": 3,
  "name": "LeetCode Chrome Extension",
  "version": "1.0.2",
  "description": "Look up stored Python solutions by LeetCode question number or current problem page.",
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "https://leetcode.com/*"
  ],
  "action": {
    "default_title": "LeetCode Python Answer Finder",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
